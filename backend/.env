# DJANGO_DEBUG=True
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# # Same MySQL database your Java app used (schema is NOT changed by Django)
# DB_NAME=synalink
# DB_USER=root
# DB_PASSWORD=root
# DB_HOST=127.0.0.1
# DB_PORT=3306

# # React dev server
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# # Legacy AES keystore (same file the Java app used)
# KEYSTORE_PATH=keystore/cobalt.jks
# KEYSTORE_PASSWORD=changeit
# KEYSTORE_ALIAS=128bitkey
# LEGACY_AES_IV=root@1234@123456

# # Auth token lifetime (minutes)
# JWT_LIFETIME_MINUTES=60

# # Patient login needs OTP (comes in Phase 2). Keep False in production.
# DEV_SKIP_PATIENT_OTP=False



# Copy this file to .env and edit the values
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Same MySQL database your Java app used (schema is NOT changed by Django)
DB_NAME=synalink
DB_USER=root
DB_PASSWORD=root
DB_HOST=127.0.0.1
DB_PORT=3306

# React dev server
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Legacy AES key (extracted from the Java cobalt.jks) - keep this file private
AES_KEY_FILE=keystore/aes_key.hex
LEGACY_AES_IV=root@1234@123456

# Auth token lifetime (minutes)
JWT_LIFETIME_MINUTES=60

# Patient login needs OTP (comes in Phase 2). Keep False in production.
DEV_SKIP_PATIENT_OTP=False

# ---- Patient OTP delivery (copy the values from your Java PatientOTPUtil / mail config) ----
# For local testing set DEV_ECHO_OTP=True: the OTP is printed in the Django console.
DEV_ECHO_OTP=True
WHATSAPP_API_URL=
WHATSAPP_API_KEY=
WHATSAPP_CAMPAIGN=patient otp generation method
WHATSAPP_USERNAME=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
